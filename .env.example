PORT=8080
HOST_PORT=8081
DISCOVERY_INTERVAL_MS=30000
DISCOVERY_TIMEOUT_MS=1500
LYRION_HTTP_PORT=9000
# Optional display name override. Useful when the server does not publish a name.
LYRION_SERVER_NAME=
# Optional fallback for Docker bridge networks or servers that do not answer broadcast discovery.
# Comma-separated hostnames or IPs, optionally with :port (default 9000).
LYRION_SERVERS=
